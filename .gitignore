# Secrets — never commit
.env
.env.*
*.key
*.pem
*.jks
*.keystore
**/google-services.json
**/GoogleService-Info.plist
**/firebase_options.dart

# Build-time config — see config/README.md
# example.json documents the keys. dev.json is committed DELIBERATELY: it
# carries only client-safe publishable values (Supabase anon key, Stripe
# pk_test, public URLs) that ship inside every app build anyway. Anything
# actually secret — service keys, DB URLs, sk_ keys — must never be added
# to it or to this repo.
config/*.json
!config/example.json
!config/dev.json
**/*.xcconfig
!**/Flutter/*.xcconfig

# Flutter / Dart
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
*.iml.bak

# Android
**/android/.gradle/
**/android/local.properties
**/android/key.properties
**/android/app/debug/
**/android/app/profile/
**/android/app/release/

# iOS
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/App.framework
**/ios/Flutter/ephemeral/
**/ios/Runner/GeneratedPluginRegistrant.*
*.mobileprovision
*.ipa

# IDE
.idea/
.vscode/
*.swp
*~

# OS
.DS_Store
Thumbs.db
NUL

